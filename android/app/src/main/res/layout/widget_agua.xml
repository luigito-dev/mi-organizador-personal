<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <ImageView
        android:id="@+id/wAguaBottle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.9"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wAguaN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widgetBlue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/wAguaG"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widgetMuted"
            android:textSize="11sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/wAguaBot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/widgetMuted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/wAguaMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widgetMuted"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wAguaMinus"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_pill"
            android:gravity="center"
            android:text="−1 oz"
            android:textColor="@color/widgetBlue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wAguaDrink"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_pill"
            android:backgroundTint="#2F7DE1"
            android:gravity="center"
            android:text="BEBER 1 oz"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
