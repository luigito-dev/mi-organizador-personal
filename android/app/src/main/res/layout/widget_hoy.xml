<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOY"
            android:textColor="@color/widgetBlue"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1" />

        <TextView
            android:id="@+id/wCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/widgetMuted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/wSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/widgetMuted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/wAdd"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_add_bg"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:contentDescription="Nueva tarea" />
    </LinearLayout>

    <TextView android:id="@+id/row1" style="@style/WidgetRow" />
    <TextView android:id="@+id/row2" style="@style/WidgetRow" />
    <TextView android:id="@+id/row3" style="@style/WidgetRow" />
    <TextView android:id="@+id/row4" style="@style/WidgetRow" />
    <TextView android:id="@+id/row5" style="@style/WidgetRow" />
    <TextView android:id="@+id/row6" style="@style/WidgetRow" />

    <TextView
        android:id="@+id/wEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="✓ Todo listo por hoy"
        android:textColor="@color/widgetGreen"
        android:textSize="14sp" />
</LinearLayout>
